{
  "name": "kevin-from-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "KEVIN: a NEAR memecoin that opens a ticket for every bug CISA adds to its Known Exploited Vulnerabilities catalog. Holding it asks nothing. Take the pager and you answer every ticket by CISA's deadline, or part of what you committed burns.",
  "scripts": {
    "dev": "vite --config web/vite.config.js --port 4150",
    "build": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js --port 4151",
    "sim": "node scripts/sim.mjs",
    "reporter": "node scripts/reporter.mjs",
    "oncall": "node scripts/oncall.mjs",
    "janitor": "node scripts/janitor.mjs",
    "drill": "node scripts/drill.mjs",
    "vex": "node scripts/vex.mjs",
    "roster": "node scripts/roster.mjs",
    "claims": "node scripts/claims.mjs",
    "test": "node --test lib/*.test.mjs web/src/*.test.mjs",
    "test:contract": "cd contract && cargo test",
    "build:contract": "cd contract && cargo near build non-reproducible-wasm"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "near-api-js": "^7.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer": "^25.17.0",
    "vite": "^8.3.8"
  }
}
